<%= form_with(model: campaign, local: true) do |form| %>
  <% if campaign.errors.any? %>
    <div class="alert alert-alert">
      <strong><%= pluralize(campaign.errors.count, "error") %> prohibited this campaign from being saved:</strong>
      <ul class="error-list">
        <% campaign.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, "Campaign Name" %>
    <%= form.text_field :name, required: true, placeholder: "e.g., E-commerce Laptops Crawl" %>
  </div>

  <div class="form-group">
    <%= form.label :description, "Description (Optional)" %>
    <%= form.text_area :description, rows: 3, placeholder: "Brief details about this job..." %>
  </div>

  <div class="form-group">
    <%= form.label :extraction_schema, "Extraction Schema (JSON)" %>
    <%= form.text_area :extraction_schema,
      rows: 8,
      value: (campaign.extraction_schema.present? ? JSON.pretty_generate(campaign.extraction_schema) : ""),
      placeholder: '{"container": ".product-card", "fields": {"title": ".name", "price": ".price", "image": "img@src"}}',
      class: "mono-input" %>
    <div class="form-hint">
      Define CSS selectors for data extraction. Use <code>@attr</code> syntax for attributes (e.g., <code>img@src</code>).
    </div>
  </div>

  <% if campaign.new_record? %>
    <div class="form-group">
      <%= label_tag :urls, "Target URLs (One per line)" %>
      <%= text_area_tag :urls, nil, rows: 10, placeholder: "https://example.com/product/1\nhttps://example.com/product/2", required: true, class: "mono-input" %>
      <div class="form-hint">
        Tasks will be generated automatically for each URL.
      </div>
    </div>
  <% end %>

  <div class="form-actions">
    <%= link_to "Cancel", campaigns_path, class: "btn btn-secondary" %>
    <%= form.submit "Save Campaign", class: "btn btn-primary" %>
  </div>
<% end %>
